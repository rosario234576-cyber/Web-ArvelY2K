FIREBASE_WEB_API_KEY=
FIREBASE_SERVICE_ACCOUNT_EMAIL=
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY=
INSTAGRAM_USER_ID=
INSTAGRAM_USERNAME=arvel.customsy2k
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Solo para el workflow de GitHub cuando se usa Instagram Login y se desea
# persistir automáticamente el token renovado. Debe ser un token de GitHub
# de alcance mínimo con permiso para escribir Actions secrets en este repositorio.
INSTAGRAM_SECRET_UPDATE_TOKEN=
# Alternativa con nombre explícito para el token de GitHub que actualiza los
# secretos de Facebook/Instagram tras una renovación automática.
FACEBOOK_SECRET_UPDATE_TOKEN=
# Opcionales para validar anticipadamente un FACEBOOK_PAGE_ACCESS_TOKEN.
# Si la app de Meta usa los mismos valores que Instagram, pueden omitirse.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
INSTAGRAM_SYNC_LIMIT=50
INSTAGRAM_REDIRECT_URI=https://www.arvelcustomy2k.store/api/instagram-callback
INSTAGRAM_AUTH_URL=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
