MP_ACCESS_TOKEN=
MP_MODE=test
# Tasas EFECTIVAS por modalidad. Son configurables porque Mercado Pago las
# define por cuenta/campaña. Expresarlas como decimal: 0.0629 = 6,29%.
# No son credenciales y se usan también para mostrar el importe estimado.
MP_MONEY_FEE_RATE=0
MP_CARD_1_FEE_RATE=
MP_CARD_2_FEE_RATE=
MP_CARD_3_FEE_RATE=
MP_WEBHOOK_SECRET=
MP_ALLOW_UNSIGNED_WEBHOOKS=false
