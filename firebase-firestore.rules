rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /products/{productId} {
      allow get: if isAdmin() || resource.data.status == "published";
      allow list: if isAdmin() || resource.data.status == "published";
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    // Cada clienta puede consultar y editar únicamente su propio perfil.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "email", "profile", "address", "createdAt", "updatedAt"
        ]);
      allow delete: if false;

      // Los pedidos se crearán desde un backend seguro. La clienta solo los lee.
      match /orders/{orderId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }
    }
  }
}
